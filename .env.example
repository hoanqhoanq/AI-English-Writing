PORT=3000
MONGODB_URI=
JWT_SECRET=super_secret_jwt_key_ai_english_writing_2025
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_ai_english_writing_2025
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
# Optional: bootstraps exactly one admin account on server start. Leave both unset
# to skip auto-creating any admin account (promote a user to admin manually instead).
ADMIN_EMAIL=
ADMIN_PASSWORD=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
# Order AI providers are tried (comma-separated: gemini, groq, openrouter). Default: gemini first.
# e.g. AI_PRIMARY_ORDER=groq,gemini,openrouter to try Groq first while Gemini is overloaded.
AI_PRIMARY_ORDER=gemini,groq,openrouter
# Sampling temperature for Groq/OpenRouter grading calls (0-2, default 0.2). Not applied to Gemini.
AI_EVALUATION_TEMPERATURE=0.2
# Reasoning effort for Groq gpt-oss models: low | medium | high (default low). Lower = fewer tokens and faster.
GROQ_REASONING_EFFORT=low
# AI Quiz Solver (upload PDF/DOCX → answers). All optional; defaults shown.
QUIZ_SOLVER_MAX_FILE_MB=10
QUIZ_SOLVER_MAX_PDF_PAGES=50
# Per AI call timeout, and total time budget for one quiz (all batches).
QUIZ_SOLVER_AI_TIMEOUT_MS=45000
# Max time spent on one provider (all its fallback models) before trying the next one.
QUIZ_SOLVER_PROVIDER_BUDGET_MS=50000
QUIZ_SOLVER_JOB_TIMEOUT_MS=180000
# A quiz within these limits is solved in ONE AI call; longer ones are batched.
QUIZ_SOLVER_BATCH_MAX_TOKENS=5000
QUIZ_SOLVER_BATCH_MAX_QUESTIONS=15
QUIZ_SOLVER_CONCURRENCY=2
QUIZ_SOLVER_MAX_TEXT_CHARS=150000
# How long a result stays in memory (re-upload / page refresh → no new AI call).
QUIZ_SOLVER_RESULT_TTL_MS=900000
# Optional Gemini thinking level for quiz solving: minimal | low | medium | high (unset = model default).
QUIZ_SOLVER_GEMINI_THINKING_LEVEL=
